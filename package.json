{
  "name": "dont-trust-the-door",
  "version": "0.1.0",
  "private": true,
  "description": "A troll platformer where the level betrays you.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173",
    "test:levels": "node tests/validate-levels.mjs",
    "test:bot": "node tests/run-selftest.mjs",
    "test": "npm run test:levels && npm run test:i18n && npm run build && npm run test:bot",
    "record": "npm run levels && vite build && node tests/author-replays.mjs",
    "media": "node tools/capture-media.mjs --screens-only",
    "levels": "node tools/level-builder/build.mjs && node tests/validate-levels.mjs",
    "test:i18n": "node tests/i18n.mjs"
  },
  "dependencies": {
    "@fontsource/nunito": "5.3.0",
    "phaser": "3.90.0"
  },
  "devDependencies": {
    "playwright": "^1.63.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0"
  }
}
